PORT=5000
NODE_ENV=development
# Leave MONGODB_URI empty to automatically use built-in MongoDB engine, or provide your Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/teamflow?retryWrites=true&w=majority
MONGODB_URI=
JWT_SECRET=teamflow_super_secret_jwt_key_2026_production_secure
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173
# Optional: GEMINI_API_KEY or CLAUDE_API_KEY for external AI summarization; otherwise smart local AI summary engine will run
GEMINI_API_KEY=
